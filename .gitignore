# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at build time by scripts/list-product-images.mjs
/lib/generated/
/public/product-images.json

# owner's original photos as sent (processed copies live in public/images/products/)
/owner-photos/
/public/images/owner-photos/

# product photos ready for products that are still hidden (move into public/images/products/ at launch)
/pending-photos/
